// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  admin
  resto
  cabang
}

enum UserStatus {
  active
  suspended
}

enum RestaurantStatus {
  active
  suspended
}

enum BranchStatus {
  active
  suspended
}

enum MenuStatus {
  pending
  active
  rejected
}

enum OrderStatus {
  waiting_payment
  pending
  processing
  ready
  completed
  cancelled
}

enum PaymentMethod {
  cash
  cashless
}

enum PaymentStatus {
  unpaid
  paid
}

model Restaurant {
  id          Int           @id @default(autoincrement())
  name        String
  description String?
  logoUrl     String?
  status      RestaurantStatus @default(active)
  createdAt   DateTime         @default(now())

  branches    Branch[]
  users       User[]
  categories  Category[]
  menus       Menu[]
}

model Branch {
  id           Int       @id @default(autoincrement())
  restaurantId Int
  name         String
  address      String?
  status       BranchStatus @default(active)
  createdAt    DateTime     @default(now())

  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id])
  users        User[]
  tableQrs     TableQr[]
  orders       Order[]
}

model User {
  id           Int     @id @default(autoincrement())
  restaurantId Int?    // null untuk admin
  branchId     Int?    // hanya untuk role cabang
  name         String
  email        String     @unique
  password     String
  role         Role
  status       UserStatus @default(active)
  createdAt    DateTime   @default(now())

  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id])
  branch       Branch?     @relation(fields: [branchId], references: [id])
}

model TableQr {
  id          Int   @id @default(autoincrement())
  branchId    Int
  tableNumber Int
  qrToken     String   @unique
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  branch      Branch   @relation(fields: [branchId], references: [id])
  orders      Order[]
}

model Category {
  id           Int     @id @default(autoincrement())
  restaurantId Int
  name         String
  sortOrder    Int        @default(0)

  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  menus        Menu[]
}

model Menu {
  id             Int     @id @default(autoincrement())
  restaurantId   Int
  categoryId     Int?
  name           String
  description    String?
  imageUrl       String?
  price          Decimal    @db.Decimal(10, 2)
  extraFee       Decimal    @default(0) @db.Decimal(10, 2)
  extraFeeLabel  String?
  isAvailable    Boolean    @default(true)
  status         MenuStatus @default(pending)
  createdAt      DateTime   @default(now())

  restaurant     Restaurant @relation(fields: [restaurantId], references: [id])
  category       Category?  @relation(fields: [categoryId], references: [id])
  orderItems     OrderItem[]
}

model Order {
  id            Int        @id @default(autoincrement())
  branchId      Int
  tableQrId     Int
  tableNumber   Int
  guestName     String
  guestPhone    String
  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(unpaid)
  grandTotal    Decimal       @db.Decimal(10, 2)
  qrCode        String        @unique @default(uuid())
  status        OrderStatus   @default(pending)
  createdAt     DateTime      @default(now())

  branch        Branch        @relation(fields: [branchId], references: [id])
  tableQr       TableQr       @relation(fields: [tableQrId], references: [id])
  orderItems    OrderItem[]
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   Int
  menuId    Int
  menuName  String  
  unitPrice Decimal @db.Decimal(10, 2) 
  quantity  Int
  subtotal  Decimal @db.Decimal(10, 2)

  order     Order   @relation(fields: [orderId], references: [id])
  menu      Menu    @relation(fields: [menuId], references: [id])
}